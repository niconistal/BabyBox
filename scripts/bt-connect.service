[Unit]
Description=BabyBox Bluetooth Speaker Auto-Connect
After=bluetooth.service network.target
Wants=bluetooth.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/babybox
# PulseAudio runs in the pi user's session (lingering enabled by setup.sh);
# pactl/bluetoothd need this to find the session bus and PA socket
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 -m software.bt_autoconnect
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
